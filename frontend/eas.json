{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "adhoc": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_DEMO": "false" }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_DEMO": "false" }
    },
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true }
    }
  },
  "submit": { "production": {} }
}
