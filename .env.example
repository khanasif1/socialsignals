# Copy to backend/.env. Replace both secrets with independent random 32+ character values.
SIGNAL_LOGIN_SECRET=replace-with-a-private-random-login-passphrase
SIGNAL_SESSION_SECRET=replace-with-an-independent-random-signing-secret
SIGNAL_ENV=development
SIGNAL_STORAGE=local
SIGNAL_LOCAL_PATH=.signal-data
SIGNAL_STORAGE_ACCOUNT=
SIGNAL_STORAGE_CONTAINER=signal-data
SIGNAL_CORS_ORIGINS=["http://localhost:8081"]
SIGNAL_AI_PROVIDER=none
SIGNAL_OPENAI_API_KEY=
SIGNAL_OPENAI_MODEL=gpt-4o-mini
SIGNAL_AZURE_OPENAI_ENDPOINT=
SIGNAL_AZURE_OPENAI_API_KEY=
SIGNAL_AZURE_OPENAI_DEPLOYMENT=
SIGNAL_AZURE_OPENAI_API_VERSION=2024-10-21
# Optional LinkedIn identity connection; DOES NOT grant home-feed access.
SIGNAL_LINKEDIN_CLIENT_ID=
SIGNAL_LINKEDIN_CLIENT_SECRET=
SIGNAL_LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
# Optional server-only browser worker. Read the terms/account-risk guidance first.
# Never copy these into frontend/.env. Use Key Vault references on Azure.
SIGNAL_LINKEDIN_CRAWLER_ENABLED=false
SIGNAL_LINKEDIN_CRAWLER_USERNAME=
SIGNAL_LINKEDIN_CRAWLER_PASSWORD=
SIGNAL_LINKEDIN_CRAWLER_MAX_POSTS=100
SIGNAL_LINKEDIN_CRAWLER_MAX_SCROLLS=20
SIGNAL_LINKEDIN_CRAWLER_MAX_SECONDS=180
SIGNAL_LINKEDIN_CRAWLER_MAX_PROCESSING_BATCHES=20
SIGNAL_LINKEDIN_CRAWLER_PROCESSING_MAX_SECONDS=600
SIGNAL_SCHEDULER_ENABLED=true
# Copy ONLY these public variables to frontend/.env. Never put secrets in frontend.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_DEMO=true
EXPO_PUBLIC_IOS_BUNDLE_ID=com.yourcompany.signal
EXPO_PUBLIC_EAS_PROJECT_ID=
# Export these in your deployment shell, not into the mobile bundle.
AZURE_SUBSCRIPTION=
AZURE_LOCATION=australiaeast
RESOURCE_GROUP=signal-personal
APP_NAME=
STORAGE_ACCOUNT=
APP_SERVICE_SKU=B1
# Optional existing-app container upgrade; keep these empty for ZIP deployment.
SIGNAL_CONTAINER_IMAGE=
LINKEDIN_USERNAME_SECRET_URI=
LINKEDIN_PASSWORD_SECRET_URI=
CONTAINER_REGISTRY_RESOURCE_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=
